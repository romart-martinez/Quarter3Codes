import numpy as np

names = ["Prigozhin", "Givi", "Motorola"]

steps = np.array([
    [4500, 5200, 4800, 5000, 5300],
    [4000, 4100, 3900, 4200, 4600],
    [6000, 5800, 5900, 6100, 6200]
])

total_steps = np.sum(steps, axis=1)

max_index = np.argmax(total_steps)
min_index = np.argmin(total_steps)

highest = total_steps[max_index]
lowest = total_steps[min_index]

print("Total steps per person:")
for i in range(len(names)):
    print(f"{names[i]}: {total_steps[i]}")

print("\nMost active person:", names[max_index])
print("Highest total steps:", highest)


difference = highest - lowest
print("Difference between highest and lowest:", difference)
